# Used by the ChatGPT Sites / Next server routes. Do not prefix secrets with NEXT_PUBLIC_.
TRANSCRIPTION_BACKEND_URL=http://127.0.0.1:8788
BACKEND_SHARED_SECRET=replace-with-a-long-random-secret

# Used only by the standalone Python backend.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
OPENAI_TRANSCRIBE_FALLBACK_MODEL=whisper-1
AUDIO_CHUNK_SECONDS=600
MAX_CONCURRENT_JOBS=2
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://ninja-transcribe.hasagi0908.chatgpt.site

# Optional when YouTube restricts the backend's server IP.
YOUTUBE_PLAYER_CLIENTS=mweb,web_safari
YOUTUBE_POT_PROVIDER_URL=http://127.0.0.1:4416
YOUTUBE_COOKIES_B64=
YOUTUBE_PROXY=
